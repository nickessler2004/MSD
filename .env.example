# Optional: local simulation and builds work without these values.
# Copy to .env.local, replace both placeholders, then restart Vite.
# Everything prefixed VITE_ is PUBLIC in the browser bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# For an older project, use its public anon JWT only if a publishable key is unavailable.
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# NEVER put a service_role JWT, sb_secret_ key, database password, or access token here.
